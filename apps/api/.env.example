APP_NAME=QAtestbuddy
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ENV=dev

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qa

# Crypto (rotate before prod). 32 bytes base64.
APP_ENCRYPTION_KEY=

# GitHub OAuth (Phase 3)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# SMTP (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost

# Observability
SENTRY_DSN=
LOGFIRE_TOKEN=

# CORS
ALLOWED_ORIGINS=http://localhost:3000
